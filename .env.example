# ─── Option A: Private Integration Token (simpler, single account) ──────────
# Generate at: Settings → Private Integrations inside your GHL sub-account
GHL_API_KEY=your_private_integration_token_here
GHL_LOCATION_ID=your_location_id_here

# ─── Option B: OAuth 2.0 (browser login, recommended for distribution) ───────
# Create a Marketplace App at: https://marketplace.gohighlevel.com
# Set the Redirect URL in your app to: http://localhost:8000/auth/callback
# Then start the server and open http://localhost:8000/auth in your browser.
# Tokens are saved automatically — no need to copy them.
GHL_CLIENT_ID=your_marketplace_app_client_id
GHL_CLIENT_SECRET=your_marketplace_app_client_secret
# GHL_REDIRECT_URI=http://localhost:8000/auth/callback  # default, change for production

# ─── Server Configuration ────────────────────────────────────────────────────
GHL_BASE_URL=https://services.leadconnectorhq.com
MCP_SERVER_PORT=8000

# BASE_URL is used to build the OAuth redirect URI and the success page URL.
# Change this if you deploy to a cloud host (e.g. https://your-app.railway.app).
# BASE_URL=http://localhost:8000

# Comma-separated list of origins allowed by CORS (localhost is always allowed).
# Example for a hosted deployment: ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com
# ALLOWED_ORIGINS=

# Optional bearer token protecting /mcp and /sse when deployed remotely.
# Clients must send "Authorization: Bearer <value>" to reach MCP endpoints.
# Leave unset for localhost-only use where network security is sufficient.
# MCP_SECRET=your_strong_random_token_here

# Optional: path to store OAuth tokens (default: .ghl-tokens.json in cwd)
# TOKEN_STORE_PATH=/home/user/.config/ghl-toolkit/tokens.json

# ─── Optional features ───────────────────────────────────────────────────────
NODE_ENV=development
# ANTHROPIC_API_KEY=your_anthropic_key_here_optional
