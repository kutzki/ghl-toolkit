{
  "name": "aio-ghl-mcp",
  "version": "1.0.0",
  "description": "All-In-One GoHighLevel MCP Server — 500+ tools, OAuth 2.0, works with Claude Desktop, Codex CLI, and Google Gemini CLI",
  "main": "dist/main.js",
  "bin": {
    "aio-ghl-mcp": "dist/server.js"
  },
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "setup": "node setup.js",
    "build:dynamic-ui": "cd src/ui/react-app && npm ci && npm run build",
    "build": "(npm run build:dynamic-ui || echo '⚠️  UI build skipped (non-fatal)') && tsc",
    "dev": "nodemon --exec ts-node src/main.ts",
    "start": "node dist/main.js",
    "start:stdio": "node dist/server.js",
    "start:http": "node dist/main.js",
    "vercel-build": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "gohighlevel",
    "goHighLevel",
    "claude",
    "codex",
    "antigravity",
    "gemini",
    "ai",
    "crm",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "zod": "^4.3.6"
  }
}
